@@ -178,6 +178,30 @@
     return ret;
 }
 
+/* Seek (stateful decoder interface): stopping the OUTPUT queue drops the
+ * bitstream the driver has not decoded yet, so frames from before the seek
+ * stop coming out; v4l2_try_start() restarts it with the next packet. Frames
+ * already decoded into CAPTURE buffers are left there. */
+static void v4l2_decode_flush(AVCodecContext *avctx)
+{
+    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
+    V4L2Context *const output = &s->output;
+    int i;
+
+    av_packet_unref(&s->buf_pkt);
+    if (!output->streamon)
+        return;
+    if (ff_v4l2_context_set_status(output, VIDIOC_STREAMOFF) < 0) {
+        av_log(avctx, AV_LOG_WARNING, "VIDIOC_STREAMOFF on output context\n");
+        return;
+    }
+    for (i = 0; i < output->num_buffers; i++)
+        if (output->buffers[i].status == V4L2BUF_IN_DRIVER)
+            output->buffers[i].status = V4L2BUF_AVAILABLE;
+    output->done = 0;
+    s->draining = 0;
+}
+
 static av_cold int v4l2_decode_init(AVCodecContext *avctx)
 {
     V4L2Context *capture, *output;
@@ -250,6 +274,7 @@
