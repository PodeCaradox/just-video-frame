--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -319,8 +319,18 @@
         ret = poll(&pfd, 1, timeout);
         if (ret > 0)
             break;
-        if (errno == EINTR)
+        if (ret < 0 && errno == EINTR)
             continue;
+        if (ret == 0 && timeout > 0 && !V4L2_TYPE_IS_OUTPUT(ctx->type) && ctx->buffers) {
+            int held = 0, queued = 0;
+            for (i = 0; i < ctx->num_buffers; i++) {
+                held   += ctx->buffers[i].status == V4L2BUF_RET_USER;
+                queued += ctx->buffers[i].status == V4L2BUF_IN_DRIVER;
+            }
+            av_log(logger(ctx), AV_LOG_ERROR, "%s: nothing decoded in %d ms "
+                   "(%d of %d buffers queued in the driver, %d held by the application)\n",
+                   ctx->name, timeout, queued, ctx->num_buffers, held);
+        }
         return NULL;
     }
 
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -172,7 +172,9 @@
     }
 
 dequeue:
-    return ff_v4l2_context_dequeue_frame(capture, frame, -1);
+    /* Not forever: if the driver never returns a buffer (no free capture
+     * buffer for it to decode into), the caller gets EAGAIN and can notice. */
+    return ff_v4l2_context_dequeue_frame(capture, frame, 500);
 fail:
     av_packet_unref(&s->buf_pkt);
     return ret;
